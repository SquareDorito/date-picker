# Google Calendar OAuth2 Credentials
# Get these from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Add http://localhost:3001/api/gcal/callback as an Authorized redirect URI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3045/api/gcal/callback
PORT=3045

# Optional: Comma-separated Google emails allowed to sign in (if unset, any test user can sign in)
ALLOWED_EMAILS=
SESSION_SECRET=
